<Page x:Class="CopilotGameBarBridge.WidgetPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#171717">
  <Grid Padding="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Copilot Bridge" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
      <TextBlock Text="Compose here, then open the unified Copilot app." Foreground="#BDBDBD" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBox x:Name="PromptBox" Grid.Row="1" Margin="0,12,0,10" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Ask about the game, paste context, or describe what is on screen..."/>
    <CheckBox x:Name="CopyFirstCheckBox" Grid.Row="2" Content="Copy prompt to clipboard before opening Copilot" IsChecked="True" Foreground="White"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button Content="Open Copilot" Click="OpenCopilot_Click" Style="{StaticResource AccentButtonStyle}"/>
      <Button Content="Copy" Click="Copy_Click"/>
      <Button Content="Clear" Click="Clear_Click"/>
    </StackPanel>
  </Grid>
</Page>
